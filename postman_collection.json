			"name": "Health",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/{{apiVersion}}/health",
							"host": ["{{baseUrl}}"],
							"path": ["api", "{{apiVersion}}", "health"]
						},
						"description": "Check if the server is running"
					},
					"response": []
